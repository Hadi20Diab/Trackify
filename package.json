{
  "name": "trackify",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n WEB,API -c blue,green \"npm:start:web\" \"npm:start:api\"",
    "start:web": "ng serve --proxy-config proxy.conf.json",
    "start:api": "node scripts/local-api.mjs",
    "dev": "concurrently -k -n WEB,API -c blue,green \"npm:start:web\" \"npm:dev:api\"",
    "dev:api": "vercel dev --listen 3000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:trackify": "node dist/trackify/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.2.7",
    "@angular/cdk": "^21.2.5",
    "@angular/common": "21.2.7",
    "@angular/compiler": "21.2.7",
    "@angular/core": "21.2.7",
    "@angular/forms": "21.2.7",
    "@angular/material": "^21.2.5",
    "@angular/platform-browser": "21.2.7",
    "@angular/platform-server": "21.2.7",
    "@angular/router": "21.2.7",
    "@angular/ssr": "^21.2.6",
    "express": "^5.1.0",
    "nodemailer": "^8.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "21.2.7",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^8.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "typescript": "~5.9.2",
    "vercel": "^48.2.9",
    "vitest": "^4.0.8"
  }
}
